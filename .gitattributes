# Normalize line endings to LF in the repository and on checkout,
# regardless of a contributor's local core.autocrlf setting - avoids the
# "LF will be replaced by CRLF" noise on every edit on Windows machines,
# and keeps line endings consistent across the whole team.
* text=auto eol=lf

# Explicit binary types - never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
